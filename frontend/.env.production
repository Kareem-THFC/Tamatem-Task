# Production builds are served by Flask from the same origin as the API, so the
# client uses relative URLs. An empty value is deliberate: the fallback in
# src/api/client.ts only applies when the variable is undefined.
VITE_API_BASE_URL=

# Shown on the login screen so a reviewer can sign in without registering.
# These are demo-only values for a throwaway seeded account.
VITE_DEMO_USERNAME=demo
VITE_DEMO_PASSWORD=demo-password
