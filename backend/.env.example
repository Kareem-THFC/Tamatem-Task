# Copy this file to .env for local development. Do not commit the real file.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_SECRET_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
# DATABASE_URL=sqlite:///commerce.db
# Origins allowed to call the API from a browser, comma separated. Defaults to
# the local Vite dev server on port 3000; set this to the deployed frontend's
# origin.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Lifetime of an access token, in hours.
# ACCESS_TOKEN_HOURS=12
# Password set by "flask --app run seed-demo-user".
# DEMO_USER_PASSWORD=demo-password
